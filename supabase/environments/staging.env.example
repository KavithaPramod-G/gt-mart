# Staging / development Supabase (separate project from production)
# Copy to staging.env and fill in after creating gt-mart-dev on Supabase.

SUPABASE_PROJECT_REF=REPLACE_WITH_DEV_PROJECT_REF
SUPABASE_URL=https://REPLACE_WITH_DEV_PROJECT_REF.supabase.co

# Mobile (Expo) — used in eas.json preview profile
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_DEV_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-or-publishable-key

# Admin (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_DEV_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

# Bootstrap empty dev DB (Dashboard → Database → Connection string URI)
SUPABASE_DB_URL=postgresql://postgres.REPLACE_WITH_DEV_PROJECT_REF:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

EXPO_PUBLIC_OTP_DEV_MODE=true
EXPO_PUBLIC_PASSWORD_AUTH=true
EXPO_PUBLIC_PHONE_ONLY_AUTH=false
