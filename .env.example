# Copy this file to `.env` and fill in your Supabase project values.
# Restart Expo after changes: npx expo start --clear

# From Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Dev only: show OTP in app when SMS is not wired yet (set false for production)
EXPO_PUBLIC_OTP_DEV_MODE=true

# Public legal pages (admin app URLs — required for Play Store)
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-admin-domain.com/privacy
# EXPO_PUBLIC_DELETE_ACCOUNT_URL=https://your-admin-domain.com/privacy/delete-account

# Online UPI (GPay / PhonePe) — shop QR / screenshot flow
# EXPO_PUBLIC_SHOP_UPI_ID=9290860984@idfcfirst
# EXPO_PUBLIC_SHOP_UPI_PAYEE_NAME=Gottipati Ramesh

# Razorpay UPI payment link. Public Key ID only.
# Never put RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET in the app or eas.json.
# EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Preview internal-test builds set this to 1 in eas.json (₹50 minimum). Leave unset for production.
# EXPO_PUBLIC_DEV_CHECKOUT=1

# Common mistakes:
# - Use EXPO_PUBLIC_ prefix (not NEXT_PUBLIC_)
# - URL must include https://
# - No quotes around values
